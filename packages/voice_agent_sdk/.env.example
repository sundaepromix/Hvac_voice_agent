# voice-agent-sdk — environment variables
#
# The SDK itself reads NONE of these — it takes credentials as explicit config.
# Your host app resolves them (tenant override -> env fallback) and passes them
# into ProviderConfig / the integration adapters. These names mirror the
# Workflow Auth backend so the Django adapter example works unchanged.

# ─── LLM providers ───────────────────────────────────────────────
# Supply at least one. ProviderConfig.provider selects which is used per turn.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model overrides (else provider defaults: claude-sonnet-4-6 / gpt-4o)
VOICE_AGENT_PROVIDER=anthropic
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o

# ─── SMS (Twilio adapter) ────────────────────────────────────────
# Leave blank to use the console stub (logs instead of sending).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Email (SMTP adapter) ────────────────────────────────────────
# Leave host/user blank to use the console stub. Works with Resend/SendGrid/etc.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@example.com
