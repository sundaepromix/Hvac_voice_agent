# ─── Postgres ────────────────────────────────────────────────────
POSTGRES_DB=dropline
POSTGRES_USER=dropline
POSTGRES_PASSWORD=dropline_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ─── Django ──────────────────────────────────────────────────────
# Set DJANGO_DEBUG=0 in production. Generate a long random SECRET_KEY.
DJANGO_SECRET_KEY=change-me-in-prod-this-is-just-for-local-dev
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# REQUIRED IN PROD. Used to encrypt per-business API keys at rest in Postgres.
# Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Rotating this value invalidates all stored credentials — set it once and back it up.
DROPLINE_ENCRYPTION_KEY=

# Default log level for app loggers (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
DROPLINE_LOG_LEVEL=INFO

# In production: which Vercel origin is allowed to call the API.
# Comma-separated list, no trailing slash.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Production VPS deploy (used by docker-compose.prod.yml + Caddy) ───
# Public hostname Caddy serves the backend on. Caddy issues a Let's Encrypt cert for this.
API_DOMAIN=api.workflowauth.com
# Public hostname Caddy serves the Next.js frontend on (only set if you also
# host the dashboard on this VPS; leave blank if frontend lives on Vercel).
APP_DOMAIN=app.workflowauth.com
# Comma-separated list of frontend origins allowed by Django CORS.
FRONTEND_ORIGIN=https://workflowauth.com,https://app.workflowauth.com

# ─── AI providers ────────────────────────────────────────────────
# The agent uses whichever provider the Business row's `llm_provider` is set to
# ("openai" or "anthropic"). Set the matching key. OPENAI_MODEL tunes speed —
# gpt-4o-mini is the low-latency default; bump to gpt-4o for harder reasoning.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─── Voice providers ────────────────────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
# REQUIRED IN PROD. Shared secret Vapi sends in the X-Vapi-Secret header on
# webhooks AND as a Bearer token on the custom-LLM endpoint. Without it,
# anyone who finds your URL can spam your Anthropic/OpenAI bill. Generate:
#   openssl rand -hex 32
# Then paste the same value into vapi.ai → assistant → Server URL → Secret.
VAPI_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Google Calendar (optional) ─────────────────────────────────
# Real availability + booked appointments land on this calendar. Create a
# service account in Google Cloud (Calendar API enabled), download its JSON
# key to ./secrets/, and share the calendar with the service account's
# client_email giving "Make changes to events". Leave blank to use built-in
# stub slots.
GOOGLE_CALENDAR_CREDENTIALS_PATH=./secrets/google-calendar-credentials.json
GOOGLE_CALENDAR_ID=

# ─── VPS deploy (docker-compose.prod.yml + Caddy) ───────────────
# APEX_DOMAIN (optional): bare domain to 301-redirect to APP_DOMAIN, e.g.
# example.com when the app lives at app.example.com. Needs an A record
# pointing at the VPS. Leave unset if you don't serve the bare domain.
# APEX_DOMAIN=

# ─── Email / SMTP ───────────────────────────────────────────────
# REQUIRED IN PROD. Dashboard login is 2-step: password + a 6-digit code
# emailed to the user. Without working SMTP, accounts that have an email on
# file cannot complete sign-in. Works with Gmail (App Password), Resend,
# SendGrid, Postmark, SES, etc. If unset, the code is only written to the
# server log (dev convenience) and login is refused with a clear error in prod.
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=no-reply@workflowauth.com

# Require the emailed 6-digit code as a second login step. Off by default
# (password alone signs you in). Only turn this on once SMTP above is verified
# working, or accounts with an email will be locked out.
LOGIN_REQUIRE_OTP=0

# ─── Frontend → Backend ─────────────────────────────────────────
# Server components (Next.js → Django) prefer INTERNAL; browser uses NEXT_PUBLIC.
# Locally:  http://backend:8000/api  (in compose)  /  http://localhost:8000/api  (browser)
# On Vercel: https://api.workflowauth.com/api for both.
INTERNAL_API_URL=http://backend:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ─── Booking / scheduling ───────────────────────────────────────
# Where every "Book a demo" button points. Defaults to the project's Calendly
# if unset. Use any scheduler URL.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/sundaepromix/30min

# ─── Talk to Mary live (Vapi web voice) ─────────────────────────
# Public (browser-safe) Vapi key + a web-enabled assistant whose custom-LLM
# model points at /api/calls/vapi/chat/completions/. When unset, the live
# voice button shows a "coming soon" notice and the scripted demo still works.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
